<?xml version="1.0"?>
<schema version="0.3">
    <table name="btBdPGalerie">
        <field name="bID" type="I">
            <KEY/>
            <UNSIGNED/>
        </field>
        <!-- Liste der Bilder als JSON -->
        <field name="bilder" type="X2"/>
        <!-- schmal | normal | weit -->
        <field name="dichte" type="C" size="16">
            <DEFAULT value="normal"/>
        </field>
        <!-- Info-Kästchen an den Bildern zeigen -->
        <field name="infos" type="I" size="1">
            <DEFAULT value="1"/>
        </field>
        <!-- Klick öffnet das Bild groß -->
        <field name="lupe" type="I" size="1">
            <DEFAULT value="1"/>
        </field>
    </table>
</schema>
