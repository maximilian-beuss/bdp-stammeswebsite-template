<?xml version="1.0"?>
<schema version="0.3">
    <table name="btBdPKalender">
        <field name="bID" type="I">
            <KEY/>
            <UNSIGNED/>
        </field>
        <!-- monat | halbjahr | jahr | liste -->
        <field name="ansicht" type="C" size="16">
            <DEFAULT value="monat"/>
        </field>
        <!-- Komma-Liste von Stufen-Handles; leer = alle -->
        <field name="stufen" type="C" size="200">
            <DEFAULT value=""/>
        </field>
        <field name="zeigeFrei" type="I" size="1">
            <DEFAULT value="1"/>
        </field>
        <field name="zeigeAbo" type="I" size="1">
            <DEFAULT value="1"/>
        </field>
        <field name="zeigeUmschalter" type="I" size="1">
            <DEFAULT value="1"/>
        </field>
        <!-- 0 = runde Punkte (Standard), 1 = Sechsecke -->
        <field name="sechseckAktiviert" type="I" size="1">
            <DEFAULT value="0"/>
        </field>
    </table>
</schema>
