<?xml version="1.0"?>
<schema version="0.3">
    <table name="btBdPBild">
        <field name="bID" type="I">
            <KEY/>
            <UNSIGNED/>
        </field>
        <!-- Liste der Bilder als JSON: bildfID, titel, text, quelle -->
        <field name="bilder" type="X2"/>
        <!-- voll | schmal | breit -->
        <field name="breite" type="C" size="16">
            <DEFAULT value="voll"/>
        </field>
        <!-- frei | quer | hoch | quadrat -->
        <field name="format" type="C" size="16">
            <DEFAULT value="frei"/>
        </field>
        <!-- Bildunterschrift sichtbar oder nur für Screenreader -->
        <field name="zeigeText" type="I" size="1">
            <DEFAULT value="1"/>
        </field>
    </table>
</schema>
